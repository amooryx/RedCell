{
  "name": "redcell",
  "productName": "RedCell",
  "version": "2.0.1",
  "description": "RedCell — a unified command console for red-team tooling. Authorised security testing only.",
  "author": "Omar Khalid Ali Mohamed Ahmed",
  "license": "MIT",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.amooryx.redcell",
    "productName": "RedCell",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RedCell-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "RedCell"
    }
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
